# Copy to .env and fill in. Names only here, never values: this file is
# committed and .env is not (see .gitignore, which ignores .env and .env.* with
# an escape for this one).
#
# Both variables below are read on the server only. Neither is prefixed VITE_,
# so neither reaches the browser bundle, and neither should ever be given that
# prefix: RESEND_API_KEY in a client bundle is a key published to everyone who
# opens the page.
#
# On Vercel these are set in Project Settings, Environment Variables, not here.
# See docs/DEPLOY.md.


# Required by the contact form. Without it every submission is refused with a
# server error rather than being reported as sent, which is deliberate: telling
# a visitor their enquiry is on its way when it reached nobody is the worst
# available outcome for a page whose only job is to start a conversation.
#
# Nothing else on the site needs it. The build does not read it, the prerender
# does not read it, and it is read at call time rather than at import, so a
# deploy without it builds and serves seven working pages with one broken form.
#
# Get one at https://resend.com, API Keys. Sending permission is enough.
RESEND_API_KEY=

# Who the enquiry appears to be from.
#
# Optional, and the default is a trap worth understanding before relying on it.
# Unset, the code falls back to `Portfolio <onboarding@resend.dev>`, which is
# Resend's sandbox sender. That address can only deliver to the address that
# owns the Resend account. Every send to anywhere else comes back as a
# validation error, which the form then reports honestly as a failure. So an
# unset CONTACT_FROM does not mean "works with a default sender", it means
# "every real enquiry fails".
#
# To fix it: verify a domain in Resend, then set this to an address at that
# domain. The display name is free text.
#
#   CONTACT_FROM=Portfolio <hello@mehby.com>
CONTACT_FROM=


# ---------------------------------------------------------------------------
# Two more variables exist and neither belongs in .env. Documented here because
# this is where somebody will look for them.
#
# VERIFY_LINKS_OFFLINE
#   Set to 1 to skip the build-time proof link check, for working without a
#   network. It prints a loud SKIPPED banner rather than passing quietly, and
#   it is IGNORED when CI is set. That refusal is the point of having the flag
#   rather than a plain opt-out: the danger is not a developer using it, it is
#   it leaking into the deploy environment where nobody would notice the gate
#   had stopped running. Vercel sets CI, so it cannot be used there. See
#   scripts/verify-links.mjs and docs/DEPLOY.md.
#
# CI
#   Set by the platform, never by you. Setting it in a local .env would make
#   the link check unskippable and make Playwright refuse to reuse a running
#   dev server. Nothing on this site needs it locally.
# ---------------------------------------------------------------------------
